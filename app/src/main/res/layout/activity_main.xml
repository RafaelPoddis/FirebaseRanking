<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="5dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditText
        android:id="@+id/nome"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Digite seu nome"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/botaoAumentarPontos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aumentar pontos"
        app:layout_constraintTop_toBottomOf="@+id/nome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/botaoDiminuirPontos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Diminuir Pontos"
        app:layout_constraintTop_toBottomOf="@+id/botaoAumentarPontos"
        app:layout_constraintBottom_toTopOf="@+id/botaoSalvarPontos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    
    <Button
        android:id="@+id/botaoSalvarPontos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salvar"
        app:layout_constraintTop_toBottomOf="@+id/botaoDiminuirPontos"
        app:layout_constraintBottom_toTopOf="@+id/rankingText"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/rankingText"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:text="Carregando ranking..."
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>


</androidx.constraintlayout.widget.ConstraintLayout>